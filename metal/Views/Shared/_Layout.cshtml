async function uploadImage(Formdata) {


    try {
        const response = await fetch('/Profile/compprofimg', { // آدرس API خود را اینجا بگذارید
            method: 'POST',
            body: Formdata
        });

        if (response.ok) {
            alert("آپلود با موفقیت انجام شد!");
        } else {
            alert("خطا در آپلود.");
        }
    } catch (error) {
        console.error("Error:", error);
    }
}



